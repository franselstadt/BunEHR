{
  "name": "bun-ehr",
  "version": "1.0.0",
  "description": "Full OpenEHR REST API v1 — TypeScript/Bun + Drizzle ORM + PostgreSQL",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/infrastructure/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@hono/zod-validator": "^0.4.1",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.6.20",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2",
    "drizzle-kit": "^0.30.4"
  }
}
