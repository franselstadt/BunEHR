          ], "type": "text/javascript" }}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/definition/template/adl1.4", "host": ["{{baseUrl}}"], "path": ["v1", "definition", "template", "adl1.4"] },
            "description": "Lists all ADL 1.4 templates stored in the `template_definition` PostgreSQL table."
          }
        },
        {
          "name": "Get template",
