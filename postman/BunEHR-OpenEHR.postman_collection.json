            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/v1/definition/template/adl1.4/{{templateId}}/example", "host": ["{{baseUrl}}"], "path": ["v1", "definition", "template", "adl1.4", "{{templateId}}", "example"] },
            "description": "Returns a skeleton COMPOSITION conforming to this template — useful as a starting point for building composition requests."
          }
        }
