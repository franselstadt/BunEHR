# ══════════════════════════════════════════════════════════════════
# Meblock EHR — BunEHR Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Loaded automatically by Bun (no dotenv package needed).
# Also read by Docker Compose for service configuration.
#
# Copy this file to .env.local to override values locally.
# Never commit secrets to version control.
# ══════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SYSTEM_ID=local.bunehr.com       # Embedded in all openEHR version UIDs

# ── Database (direct connection string) ───────────────────────────
# Used by the app and drizzle-kit. Automatically picked up by Bun.
DATABASE_URL=postgres://ehr_user:ehr_pass@localhost:5433/ehrdb

# ── PostgreSQL service config (Docker Compose) ────────────────────
POSTGRES_DB=ehrdb
POSTGRES_USER=ehr_user
POSTGRES_PASSWORD=ehr_pass
POSTGRES_HOST_PORT=5433          # Maps to container port 5432.
                                  # Uses 5433 to avoid clashing with
                                  # any system PostgreSQL on 5432.

# ── pgAdmin ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@bunehr.com   # Login: http://localhost:5050
PGADMIN_PASSWORD=admin
PGADMIN_HOST_PORT=5050

# ── Docker service ports ──────────────────────────────────────────
BUN_EHR_PORT=3000                # API: http://localhost:3000
FRONTEND_PORT=5173               # Frontend: http://localhost:5173
